<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What macOS moves into OldTunes's sandbox container the first time a sandboxed OldTunes opens on a
  Mac: the settings and the library index that OldTunes kept in ~/Library before it was sandboxed.
  It runs once, when the container is made, and never again (RESEARCH.md §3.1). The old log stays
  in ~/Library/Logs/OldTunes.
-->
<plist version="1.0">
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/OldTunes</string>
		<string>${Library}/Preferences/com.noahtsutsui.oldtunes.plist</string>
	</array>
</dict>
</plist>
